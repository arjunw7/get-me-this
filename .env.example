# Optional foundation configuration. The deterministic reference route does not
# require any of these values. Never commit real credentials to this file.
#
# Two classes of configuration exist:
#
#   * Browser-exposed: names prefixed NEXT_PUBLIC_. Next.js inlines these into
#     the client bundle, so they must contain only values intended for public
#     clients. These are the only Supabase values client code may receive.
#
#   * Server-only: read exclusively by server-side code. They must never appear
#     in a client bundle, fixture, commit, log, screenshot, or pull request.
#
# Local Supabase URLs and keys are produced by `pnpm db:start` and
# `pnpm db:status`; they belong in `.env.local` (git-ignored) and are never
# committed. See supabase/README.md.

# --- Browser-exposed (public clients) ---------------------------------------

# Public Supabase project URL, used by a later approved authentication slice.
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase publishable key, used by a later approved authentication slice.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public PostHog project token, used by a later approved analytics slice.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# PostHog host, used by a later approved analytics slice.
NEXT_PUBLIC_POSTHOG_HOST=

# --- Server-only (never exposed to browser code) ----------------------------

# Service-role/secret key for exceptional, narrowly scoped server-side
# operations. It bypasses Row Level Security and must never reach client code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Resend API key, used by a later approved email slice.
RESEND_API_KEY=
